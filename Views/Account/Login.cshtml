@model RaceDayMVC.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-primary">RaceDay</h2>
                        <p class="text-muted">Welcome back! Log in to your account.</p>
                    </div>

                    <form asp-action="Login" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                Email Address
                            </label>
                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter your email" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">
                                Password
                            </label>
                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Enter your password" />
                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Login
                        </button>

                    </form>
                    @if (TempData["DebugRole"] != null)
                    {
                        <div class="alert alert-info">
                            @TempData["DebugRole"]
                        </div>
                    }

                    <div class="text-center mt-4">
                        Don't have an account?
                        <a asp-action="Register">Register here</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
