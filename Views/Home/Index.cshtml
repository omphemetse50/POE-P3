@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<section class="raceday-hero">

    <div class="hero-overlay"></div>

    <div class="container hero-content">

        <span class="hero-tag">WELCOME TO RACEDAY</span>

        <h1>
            EVERY STEP<br />
            <span>COUNTS.</span>
        </h1>

        <p>
            Join exciting sporting events.
            Challenge yourself.
            Celebrate every finish line.
        </p>

        <a asp-controller="Account"
           asp-action="Register"
           class="btn raceday-gold-button btn-lg">
            JOIN RACEDAY
            <span class="ms-2">→</span>
        </a>

        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-outline-light btn-lg ms-2">
            LOGIN
        </a>

    </div>

    <div class="hero-bottom-text">
        RUN. RIDE. ACHIEVE.
    </div>

</section>


<!-- INTRODUCTION -->
<section class="container py-5">

    <div class="text-center mb-5">

        <span class="section-label">YOUR NEXT CHALLENGE STARTS HERE</span>

        <h2 class="section-heading">
            FIND YOUR FINISH LINE
        </h2>

        <p class="text-muted">
            Whether you run, walk or cycle, there's an event waiting for you.
        </p>

    </div>

    <div class="row g-4">

        <!-- RUNNING -->
        <div class="col-md-6 col-lg-4">

            <div class="home-event-card">

                <div class="home-event-image running-image"></div>

                <div class="p-4">

                    <span class="event-category">RUNNING</span>

                    <h4 class="fw-bold mt-2">
                        Road Running
                    </h4>

                    <p class="text-muted">
                        Challenge your limits and experience the excitement
                        of road-running events.
                    </p>

                    <a asp-controller="Participant"
                       asp-action="Index"
                       class="raceday-text-link">
                        EXPLORE EVENTS →
                    </a>

                </div>

            </div>

        </div>


        <!-- CYCLING -->
        <div class="col-md-6 col-lg-4">

            <div class="home-event-card">

                <div class="home-event-image cycling-image"></div>

                <div class="p-4">

                    <span class="event-category">CYCLING</span>

                    <h4 class="fw-bold mt-2">
                        Cycling Challenges
                    </h4>

                    <p class="text-muted">
                        Take on exciting cycling routes and push yourself
                        towards new achievements.
                    </p>

                    <a asp-controller="Participant"
                       asp-action="Index"
                       class="raceday-text-link">
                        EXPLORE EVENTS →
                    </a>

                </div>

            </div>

        </div>


        <!-- WALKING -->
        <div class="col-md-6 col-lg-4">

            <div class="home-event-card">

                <div class="home-event-image walking-image"></div>

                <div class="p-4">

                    <span class="event-category">WALKING</span>

                    <h4 class="fw-bold mt-2">
                        Walking Events
                    </h4>

                    <p class="text-muted">
                        Take part, enjoy the journey and celebrate
                        every milestone.
                    </p>

                    <a asp-controller="Participant"
                       asp-action="Index"
                       class="raceday-text-link">
                        EXPLORE EVENTS →
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- WHY RACEDAY -->
<section class="raceday-features py-5">

    <div class="container">

        <div class="text-center mb-5">

            <span class="section-label">MORE THAN JUST AN EVENT</span>

            <h2 class="text-white fw-bold">
                YOUR JOURNEY. YOUR ACHIEVEMENT.
            </h2>

        </div>

        <div class="row g-4 text-center">

            <div class="col-md-4">

                <div class="feature-item">

                    <div class="feature-icon">01</div>

                    <h5>Discover Events</h5>

                    <p>
                        Find running, cycling and walking events
                        in one convenient place.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="feature-item">

                    <div class="feature-icon">02</div>

                    <h5>Track Your Results</h5>

                    <p>
                        Keep track of your recorded finishing times
                        and positions.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="feature-item">

                    <div class="feature-icon">03</div>

                    <h5>Celebrate Progress</h5>

                    <p>
                        Look back at your sporting achievements
                        and keep moving forward.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- MOTIVATIONAL BANNER -->
<section class="container py-5">

    <div class="raceday-motivation">

        <div class="motivation-overlay"></div>

        <div class="motivation-content">

            <h2>
                SUCCESS IS EARNED,<br />
                <span>NOT GIVEN.</span>
            </h2>

            <p>
                KEEP TRAINING. KEEP BELIEVING. KEEP ACHIEVING.
            </p>

        </div>

    </div>

</section>


<!-- FINAL CALL TO ACTION -->
<section class="container text-center pb-5">

    <h2 class="fw-bold">
        READY FOR YOUR NEXT CHALLENGE?
    </h2>

    <p class="text-muted">
        Your next achievement starts with one step.
    </p>

    <a asp-controller="Account"
       asp-action="Register"
       class="btn raceday-gold-button btn-lg">
        GET STARTED →
    </a>

</section>
