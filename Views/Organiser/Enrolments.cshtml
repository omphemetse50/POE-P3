@model List<RaceDayMVC.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Enrolment Management</h1>
            <p class="text-muted">
                View participant enrolments for RaceDay events.
            </p>
        </div>

        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">Registered Enrolments</h5>

            <p class="text-muted">
                Total Enrolments: @(Model?.Count ?? 0)
            </p>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    No enrolments have been recorded yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Enrolment ID</th>
                                <th>Participant</th>
                                <th>Email</th>
                                <th>Event</th>
                                <th>Category</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var enrolment in Model)
                            {
                                <tr>
                                    <td>@enrolment.EnrolmentID</td>
                                    <td class="fw-semibold">
                                        @enrolment.ParticipantName
                                    </td>
                                    <td>@enrolment.ParticipantEmail</td>
                                    <td>@enrolment.EventName</td>
                                    <td>
                                        @(string.IsNullOrEmpty(enrolment.CategoryName)
                                                                        ? "Not specified"
                                                                        : enrolment.CategoryName)
                                                                                             </td>
                                                                                             <td>
                                        @(enrolment.EnrolmentDate?.ToString("dd MMM yyyy")
                                                                        ?? "N/A")
                            </td>
                            <td>
                                @if (enrolment.EnrolmentStatus == "Confirmed")
                                        {
                                            <span class="badge bg-success">Confirmed</span>
                                        }
                                        else if (enrolment.EnrolmentStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @enrolment.EnrolmentStatus
                                            </span>
                                        }
                            </td>
                                    <td>
                                        @if (enrolment.EnrolmentStatus == "Pending")
                                        {
                                            <form asp-controller="Organiser"
                                                  asp-action="ConfirmEnrolment"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@enrolment.EnrolmentID" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm"
                                                        onclick="return confirm('Confirm this enrolment?')">
                                                    Confirm
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No action needed</span>
                                        }
                                    </td>
                        </tr>
                                                }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>