
@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-2">Edit Event</h2>
            <p class="text-muted mb-4">
                Update the information for this RaceDay event.
            </p>

            <form asp-action="EditEvent"
                  asp-route-id="@Model.EventID"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Event Name
                    </label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label">
                        Location
                    </label>
                    <input asp-for="Location"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="EventType" class="form-label">
                        Event Type
                    </label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Running">Running</option>
                        <option value="Walking">Walking</option>
                        <option value="Cycling">Cycling</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Date" class="form-label">
                        Event Date
                    </label>
                    <input asp-for="Date"
                           type="date"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Distance" class="form-label">
                        Distance
                    </label>
                    <input asp-for="Distance"
                           class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Dashboard"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>
        </div>
    </div>
</div>
