@model RaceDayMVC.Models.AddResultViewModel

@{
    ViewData["Title"] = "Record Result";
}

<div class="container mt-5">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Record Participant Result</h1>
            <p class="text-muted">
                Enter the finishing time and position for a participant.
            </p>
        </div>

        <a asp-action="Results"
           class="btn btn-outline-secondary">
            Back to Results
        </a>
    </div>

    <!-- RESULT FORM -->
    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        Result Information
                    </h5>

                    <form asp-action="CreateResult" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- PARTICIPANT ENROLMENT -->
                        <div class="mb-3">

                            <label asp-for="EnrolmentID"
                                   class="form-label fw-semibold">
                                Select Confirmed Enrolment
                            </label>

                            <select asp-for="EnrolmentID"
                                    class="form-select">

                                <option value="">
                                    -- Select Participant --
                                </option>

                                @foreach (var enrolment in Model.AvailableEnrolments)
                                {
                                    <option value="@enrolment.EnrolmentID">
                                        @enrolment.ParticipantName -
                                        @enrolment.EventName -
                                        @enrolment.CategoryName
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="EnrolmentID"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- FINISHING TIME -->
                        <div class="mb-3">

                            <label asp-for="FinishTime"
                                   class="form-label fw-semibold">
                                Finishing Time
                            </label>

                            <input asp-for="FinishTime"
                                   type="time"
                                   step="1"
                                   class="form-control" />

                            <span asp-validation-for="FinishTime"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                Enter the participant's finishing time.
                            </small>

                        </div>

                        <!-- FINISHING POSITION -->
                        <div class="mb-4">

                            <label asp-for="Position"
                                   class="form-label fw-semibold">
                                Finishing Position
                            </label>

                            <input asp-for="Position"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="e.g. 1" />

                            <span asp-validation-for="Position"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- SUBMIT -->
                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">
                                Save Result
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}