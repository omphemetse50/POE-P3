@model List<RaceDayMVC.Models.ParticipantViewModel>

@{
    ViewData["Title"] = "Manage Participants";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Participants</h1>
            <p class="text-muted">
                View all registered RaceDay participants.
            </p>
        </div>

        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">Registered Participants</h5>

            <p class="text-muted">
                Total Participants: @(Model?.Count ?? 0)
            </p>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    No registered participants were found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Gender</th>
                                <th>City</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var participant in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@participant.Name</td>
                                    <td>@participant.Email</td>
                                    <td>@participant.PhoneNumber</td>
                                    <td>@participant.Gender</td>
                                    <td>@participant.City</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>